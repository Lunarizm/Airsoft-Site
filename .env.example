# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE KEY -- this one bypasses ALL row level security.
# It must NEVER start with NEXT_PUBLIC_ and must NEVER be committed.
# If this leaks, anyone can read and delete your entire database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
